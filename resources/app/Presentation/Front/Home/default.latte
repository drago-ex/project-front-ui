{templateType App\Presentation\Front\Home\HomeTemplate}

{block content}
	<section>
		<div class="blog-heading">
			<h1 class="blog-title">{_'Latest articles'}</h1>
			<a n:if="$list->articles" n:href=":Front:Blog:">{_'All articles'} &rarr;</a>
		</div>

		{include '../Blog/@article-list.latte', list: $list}
	</section>
{/block}
